# Ri-li 3.1.6 for AmigaOS 3.x, 68040/68060 + FPU, on OpenGPU's SDL 2.
#
#   make -f amiga/Makefile.amigaos -j2 dist \
#        STOVE=/path/to/openamigagcc-16.2.0-open4 \
#        SDL2KIT=/path/to/opengpu-sdk
#
# CMake is not run: these are CMakeLists.txt's sources and its C++11.
# SDL2KIT is the OpenGPU developer kit (SDL2 and SDL2_mixer: the program's
# halves of LIBS:OpenGPU's modules). SimpleIni v4.22 (amiga/simpleini, MIT;
# upstream's CMake fetches it) is compiled in.

STOVE   ?= $(HOME)/CradleLab/toolchain/openamigagcc-16.2.0-open4-x86_64-linux
SDL2KIT ?= /mnt/amigachrome/team2/deps/opengpu-sdk
CC      = $(STOVE)/bin/m68k-amigaos-gcc
CXX     = $(STOVE)/bin/m68k-amigaos-g++
STRIP   = $(STOVE)/bin/m68k-amigaos-strip
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too).
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns

BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
GEN     = $(BUILD)/gen
PROG    = Ri-li
OUT     = dist/Ri-li

DEFS    = -D__amigaos__ -DNDEBUG
INC     = -I$(GEN) -Isrc -Iamiga/simpleini -I$(SDL2KIT)/include -I$(SDL2KIT)/include/SDL2
CFLAGS  = -noixemul $(OPT) $(CPU) -fno-common -MMD -MP
CXXFLAGS = $(CFLAGS) $(DEFS) $(INC) -std=gnu++11 -Wno-psabi -include amiga/amiga_prelude.hpp
LDFLAGS = -noixemul $(CPU)
LIBS    = -L$(SDL2KIT)/lib -lSDL2_mixer -lSDL2 -lpthread -latomic -lm

SRC     = $(wildcard src/*.cc)
CSRC    = amiga/stack.c amiga/simpleini/ConvertUTF.c
OBJS    = $(SRC:%.cc=$(OBJDIR)/%.o) $(CSRC:%.c=$(OBJDIR)/%.o)
ICONS   = $(wildcard amiga/icons/*.info)

all: $(BUILD)/$(PROG)

$(GEN)/config.h: src/config.h.in
	@mkdir -p $(dir $@)
	sed -e 's/@LIRI_VERSION@/3.1.6/' -e 's,@LIRI_DATA_DIR@,PROGDIR:data,' $< > $@

$(OBJS): $(GEN)/config.h

$(BUILD)/$(PROG): $(OBJS)
	$(CXX) $(LDFLAGS) -o $@.debug $(OBJS) $(LIBS)
	$(STRIP) -o $@ $@.debug

$(OBJDIR)/%.o: %.cc
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(OBJDIR)/amiga/%.o: amiga/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -std=gnu99 -Wall -c -o $@ $<

# The drawer: the program, the game's data/ (the sprites, the levels, the
# 19 languages' pictures and the sounds), ReadMe and the licences. The
# settings (li-ri.ini) are written beside the program.
dist: $(BUILD)/$(PROG) $(ICONS) AMIGA_PORT.md
	rm -rf $(OUT) && mkdir -p $(OUT)/data
	cp $(BUILD)/$(PROG) $(OUT)/
	cp data/*.dat data/language.* data/gamecontrollerdb.txt $(OUT)/data/
	cp -R Sounds $(OUT)/data/Sounds
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp COPYING $(OUT)/COPYING.txt
	cp COPYING.Music $(OUT)/COPYING-Music.txt
	cp amiga/simpleini/LICENCE.txt $(OUT)/SimpleIni-LICENCE.txt
	cp amiga/icons/Ri-li.info amiga/icons/ReadMe.info $(OUT)/
	for f in COPYING.txt COPYING-Music.txt SimpleIni-LICENCE.txt; do cp amiga/icons/ReadMe.info $(OUT)/$$f.info; done
	cp amiga/icons/Folder.info $(OUT)/data.info
	cp amiga/icons/Ri-li-drawer.info dist/Ri-li.info

-include $(OBJS:.o=.d)

clean:
	rm -rf $(BUILD)

.PHONY: all clean dist
